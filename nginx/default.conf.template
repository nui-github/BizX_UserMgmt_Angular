server {
  listen 4200;

  location / {
    root /usr/share/nginx/html;
    index index.html index.html;
    try_files $uri $uri/ /usermanagement/index.html =404;
  }

  location /api {
    client_max_body_size 60M;
    proxy_cache off;
    proxy_pass http://${DOCHUB_USERMANAGEMENT_API_HOST}:${DOCHUB_USERMANAGEMENT_API_PORT};
  }
}
